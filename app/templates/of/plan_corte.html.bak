{% extends "base.html" %}
{% block title %}Plan de Corte — Samitex{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.css">
<style>
/* ── Frappe Gantt — tema oscuro ─────────────────────────────── */
.gantt-container { background: transparent; font-family: inherit; }
.gantt .grid-background { fill: transparent; }
.gantt .grid-header { fill: #111; stroke: #222; }
.gantt .grid-row { fill: transparent; }
.gantt .grid-row:nth-child(even) { fill: rgba(255,255,255,.018); }
.gantt .row-line { stroke: #1a1a1a; }
.gantt .tick { stroke: #222; stroke-width: 1; }
.gantt .tick.thick { stroke: #2e2e2e; }
.gantt .today-highlight { fill: rgba(74,159,255,.07); }
.gantt .arrow { fill: none; stroke: #333; stroke-width: 1.2; }
.gantt .bar { fill: #1a3555; stroke: none; }
.gantt .bar-progress { fill: #2a6cb5; }
.gantt .bar-wrapper:hover .bar { fill: #224a7a; }
.gantt .bar-invalid { fill: transparent; stroke: #666; stroke-width:1; stroke-dasharray:5; }
.gantt .bar-label { fill: #ddd !important; font-size: 11px !important; font-family: inherit !important; }
.gantt .lower-text { fill: #555 !important; font-size: 10px !important; font-family: inherit !important; }
.gantt .upper-text { fill: #777 !important; font-size: 11px !important; font-family: inherit !important; }
.gantt .handle { fill: #4a9fff; cursor: ew-resize; }

/* Colores por semáforo */
.bar-rojo    .bar { fill: #3f1212; } .bar-rojo    .bar-progress { fill: #c0392b; }
.bar-naranja .bar { fill: #3f2500; } .bar-naranja .bar-progress { fill: #c87f0a; }
.bar-verde   .bar { fill: #0b2a14; } .bar-verde   .bar-progress { fill: #1e7d34; }
.bar-default .bar { fill: #1a1a30; } .bar-default .bar-progress { fill: #3a3a80; }
.bar-morado  .bar { fill: #2a0a4e; } .bar-morado  .bar-progress { fill: #7c3aed; }

/* Popup oscuro */
.gantt-container .popup-wrapper {
  background: #181818 !important; border: 1px solid #2e2e2e !important;
  border-radius: 6px !important; box-shadow: 0 8px 28px rgba(0,0,0,.65) !important;
  min-width: 0 !important; padding: 0 !important;
}
.gantt-container .popup-wrapper .title,
.gantt-container .popup-wrapper .subtitle { display: none !important; }
.gantt-container .pointer { border-top-color: #181818 !important; }

/* Tabla de prioridades */
.prio-wrap { overflow-x: auto; }
.prio-table { width:100%; border-collapse:collapse; font-size:12px; }
.prio-table th { background:#0e0e0e; color:#555; font-size:10px; font-weight:500;
  text-transform:uppercase; letter-spacing:.4px; padding:6px 10px;
  border-bottom:1px solid #1e1e1e; white-space:nowrap; }
.prio-table td { padding:6px 10px; border-bottom:1px solid #161616; vertical-align:middle; }
.prio-table tr[draggable]:hover td { background:#161616; cursor:grab; }
.prio-table tr.is-dragging { opacity:.3; }
.prio-table tr.drag-over td { border-top: 2px solid #4a9fff !important; }
.drag-handle { color:#333; font-size:15px; user-select:none; cursor:grab; }
.drag-handle:active { cursor:grabbing; }
.row-num { color:#555; font-size:11px; min-width:18px; display:inline-block; text-align:center; }

/* APT colors */
.apt-red    { color:#e57373; font-weight:600; }
.apt-orange { color:#e6a817; font-weight:600; }
.apt-green  { color:#4caf7d; }

/* Controles vista */
.view-btns { display:flex; gap:3px; }
.view-btn { padding:4px 10px; font-size:11px; background:#1a1a1a; border:1px solid #2a2a2a;
  color:#777; border-radius:4px; cursor:pointer; transition:all .15s; }
.view-btn:hover { border-color:#4a9fff; color:#4a9fff; }
.view-btn.active { background:#1c3050; border-color:#4a9fff; color:#4a9fff; }

/* Toast */
.toast { position:fixed; bottom:22px; right:22px; padding:9px 16px; border-radius:5px;
  font-size:12px; color:#fff; z-index:9999; opacity:0; transform:translateY(6px);
  transition:all .25s; pointer-events:none; }
.toast.show { opacity:1; transform:translateY(0); }
</style>
{% endblock %}

{% block content %}
<div class="page-header">
  <span class="page-title">Plan de Corte</span>
  <div style="display:flex;gap:6px;align-items:center">
    <div class="view-btns" id="viewBtns">
      <button class="view-btn active" data-mode="Week">Semana</button>
      <button class="view-btn" data-mode="Month">Mes</button>
      <button class="view-btn" data-mode="Day">Día</button>
    </div>
    <button class="btn btn-secondary btn-sm" id="btnHoy">Hoy</button>
    <a href="/" class="btn btn-secondary btn-sm">← Dashboard</a>
  </div>
</div>

{% if not ofs %}
<div class="card" style="text-align:center;padding:48px;color:#555">
  No hay OFs registradas.
  <div style="margin-top:12px"><a href="/of/crear" class="btn btn-primary">+ Nueva OF</a></div>
</div>

{% else %}

<!-- Tabla de prioridades (drag-to-reorder) -->
<div class="card" style="padding:0;overflow:hidden;margin-bottom:6px">
  <div class="prio-wrap">
    <table class="prio-table">
      <thead>
        <tr>
          <th style="width:22px"></th>
          <th style="width:26px">#</th>
          <th>N° OF</th>
          <th>Cliente</th>
          <th>Tipo</th>
          <th>Inicio Corte</th>
          <th>APT</th>
          <th>Estado</th>
          <th style="min-width:110px">Avance</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="prioBody">
      {% for item in ofs %}
      {% set of = item.of %}
      {% set sem = item.semaforo %}
      <tr draggable="true" data-of-id="{{ of.id }}">
        <td><span class="drag-handle" title="Arrastrar para cambiar prioridad">⠿</span></td>
        <td><span class="row-num">{{ loop.index }}</span></td>
        <td><strong style="color:#ccc">{{ of.numero_of }}</strong></td>
        <td style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#aaa">{{ of.cliente }}</td>
        <td style="color:#777">{{ of.tipo_prenda.value }}</td>
        <td>
          <span class="inicio-display" data-of-id="{{ of.id }}"
                data-value="{{ item.fecha_inicio_str if of.fecha_inicio_plan else '' }}"
                onclick="abrirFechaInicio(this)"
                title="Click para editar fecha de inicio"
                style="cursor:pointer;color:{{ '#4a9fff' if of.fecha_inicio_plan else '#444' }}">
            {% if of.fecha_inicio_plan %}
              {{ item.fecha_inicio_str[8:10] }}/{{ item.fecha_inicio_str[5:7] }}/{{ item.fecha_inicio_str[0:4] }}
            {% else %}
              <span style="font-size:11px;border-bottom:1px dashed #333;">+ Asignar</span>
            {% endif %}
          </span>
          <span class="inicio-editor" style="display:none;align-items:center;gap:1px;
                background:#0d1e35;border:1px solid #1a6fbe;border-radius:4px;padding:1px 4px;">
            <input class="fecha-dd" maxlength="2" placeholder="DD" autocomplete="off"
                   style="width:32px;background:none;border:none;color:#e0e0e0;
                          font-size:11px;outline:none;text-align:center;"
                   onkeydown="fechaKey(this,event,'dd')">
            <span style="color:#555;font-size:11px;">/</span>
            <input class="fecha-mm" maxlength="2" placeholder="MM" autocomplete="off"
                   style="width:32px;background:none;border:none;color:#e0e0e0;
                          font-size:11px;outline:none;text-align:center;"
                   onkeydown="fechaKey(this,event,'mm')">
            <span style="color:#555;font-size:11px;">/</span>
            <input class="fecha-yyyy" maxlength="4" placeholder="YYYY" autocomplete="off"
                   style="width:54px;background:none;border:none;color:#e0e0e0;
                          font-size:11px;outline:none;text-align:center;"
                   onkeydown="fechaKey(this,event,'yyyy')">
            <span style="color:#555;font-size:10px;cursor:pointer;margin-left:4px;"
                  onclick="cancelarFechaInicio(this.closest('.inicio-editor'))">✕</span>
          </span>
        </td>
        <td>
          {% if of.fecha_apt %}
          <span class="{{ item.apt_class }}">{{ of.fecha_apt }}</span>
          {% else %}<span style="color:#444">—</span>{% endif %}
        </td>
        <td><span class="badge badge-{{ of.estado.value.lower() }}">{{ of.estado.value }}</span></td>
        <td>
          <div style="display:flex;align-items:center;gap:5px">
            <div style="width:90px;background:#111;border-radius:3px;height:5px;overflow:hidden;flex-shrink:0;border:1px solid #1e1e1e">
              <div style="width:{{ item.pct }}%;height:100%;background:{% if item.pct==100 %}#1e7d34{% elif item.pct>=50 %}#c87f0a{% else %}#2a6cb5{% endif %}"></div>
            </div>
            <span style="font-size:10px;color:#555">{{ item.pct }}%</span>
          </div>
        </td>
        <td>
          <div style="display:flex;gap:4px">
            <a href="/of/{{ of.id }}/detalle" class="btn btn-secondary btn-sm" style="font-size:10px;padding:2px 7px">Det</a>
            <a href="/corte/{{ of.id }}"      class="btn btn-primary btn-sm"   style="font-size:10px;padding:2px 7px">Corte</a>
          </div>
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<!-- Gantt chart -->
<div class="card" style="padding:16px 10px;overflow-x:auto">
  <div id="gantt-target"></div>
</div>

<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.min.js"></script>
<script>
// Datos serializados desde Python
const tasksData = {{ tasks_json | safe }};

// Helpers
function fmtDate(d) {
  const dt = (d instanceof Date) ? d : new Date(d);
  return dt.getFullYear() + '-' +
    String(dt.getMonth() + 1).padStart(2, '0') + '-' +
    String(dt.getDate()).padStart(2, '0');
}
function fmtDisp(s) {
  if (!s) return '—';
  const [y, m, d] = s.split('-');
  return `${d}/${m}/${y}`;
}
function toast(msg, ok = true) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.style.background = ok ? '#1e7d34' : '#c0392b';
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2500);
}
async function patchPlan(ofId, payload) {
  try {
    const r = await fetch(`/of/api/${ofId}/planificar`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    return r.ok;
  } catch { return false; }
}

// Gantt
let gantt;
function initGantt(tasks) {
  document.getElementById('gantt-target').innerHTML = '';
  gantt = new Gantt('#gantt-target', tasks, {
    view_mode: 'Week',
    date_format: 'YYYY-MM-DD',
    bar_height: 24,
    padding: 14,
    language: 'en',

    on_date_change: async function(task, start, end) {
      const newStart = fmtDate(start);
      const newEnd   = fmtDate(end);
      const aptStr   = task._apt;  // APT original — nunca se modifica desde el Gantt

      // ¿El arrastre superó la fecha APT?
      if (aptStr && newEnd > aptStr) {
        toast('⚠ No se puede pasar la fecha APT (' + fmtDisp(aptStr) + ')', false);
        // Snap-back: restaurar barra a inicio guardado → APT original
        const td = tasksData.find(t => t.id === task.id);
        if (td) { task.start = td.start; task.end = td.end; }
        setTimeout(() => gantt.refresh(tasksData), 30);
        return;
      }

      // Solo guardamos fecha_inicio_plan; la APT no cambia desde aquí
      const ok = await patchPlan(task.id, { fecha_inicio_plan: newStart });

      // Actualizar datos locales para mantener coherencia
      const td = tasksData.find(t => t.id === task.id);
      if (td) { td.start = newStart; }

      // Redibujar para que el extremo derecho quede en APT (no en newEnd)
      setTimeout(() => gantt.refresh(tasksData), 30);

      toast(ok ? `✓ Inicio de ${task.name}: ${fmtDisp(newStart)}` : 'Error al guardar', ok);
    },

    custom_popup_html: function(task) {
      return `
        <div style="padding:11px 14px;min-width:195px;font-family:inherit">
          <div style="font-weight:600;color:#ddd;margin-bottom:4px;font-size:13px">${task.name}</div>
          <div style="font-size:11px;color:#777;margin-bottom:6px">${task._cliente}</div>
          <div style="font-size:11px;color:#666;line-height:1.8">
            Inicio&nbsp;plan: <strong style="color:#aaa">${fmtDisp(task.start)}</strong><br>
            APT: <strong style="color:#aaa">${task._apt ? fmtDisp(task._apt) : '—'}</strong><br>
            Avance: <strong style="color:#4a9fff">${task.progress}%</strong>
          </div>
          <div style="margin-top:9px;display:flex;gap:12px;font-size:11px">
            <a href="/of/${task.id}/detalle" style="color:#4a9fff;text-decoration:none">Ver detalle →</a>
            <a href="/corte/${task.id}"      style="color:#4caf7d;text-decoration:none">Ir a Corte →</a>
          </div>
        </div>`;
    },
  });
}
initGantt(tasksData);

// Controles de vista
document.getElementById('viewBtns').addEventListener('click', e => {
  const btn = e.target.closest('.view-btn');
  if (!btn) return;
  document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  gantt.change_view_mode(btn.dataset.mode);
});
document.getElementById('btnHoy').addEventListener('click', () => {
  gantt.change_view_mode('Week');
  document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
  document.querySelector('.view-btn[data-mode="Week"]').classList.add('active');
});

// Drag-to-reorder prioridades
const tbody = document.getElementById('prioBody');
let dragSrc = null;

tbody.addEventListener('dragstart', e => {
  dragSrc = e.target.closest('tr');
  if (dragSrc) dragSrc.classList.add('is-dragging');
  if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
});
tbody.addEventListener('dragend', () => {
  tbody.querySelectorAll('tr').forEach(r => r.classList.remove('is-dragging', 'drag-over'));
  dragSrc = null;
});
tbody.addEventListener('dragover', e => {
  e.preventDefault();
  const target = e.target.closest('tr');
  if (!target || target === dragSrc) return;
  tbody.querySelectorAll('tr').forEach(r => r.classList.remove('drag-over'));
  target.classList.add('drag-over');
  if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
});
tbody.addEventListener('drop', e => {
  e.preventDefault();
  const target = e.target.closest('tr');
  if (!target || target === dragSrc) return;
  const rows = [...tbody.querySelectorAll('tr')];
  if (rows.indexOf(dragSrc) < rows.indexOf(target)) target.after(dragSrc);
  else target.before(dragSrc);
  saveOrder();
});

// ── Edición inline de fecha de inicio ────────────────────────
function abrirFechaInicio(displaySpan) {
  // Cerrar cualquier otro editor abierto
  document.querySelectorAll('.inicio-editor').forEach(function(ed) {
    if (ed.style.display !== 'none') {
      ed.style.display = 'none';
      ed.previousElementSibling.style.display = '';
    }
  });
  const editor = displaySpan.nextElementSibling;
  const val    = displaySpan.dataset.value;
  const dd     = editor.querySelector('.fecha-dd');
  const mm     = editor.querySelector('.fecha-mm');
  const yyyy   = editor.querySelector('.fecha-yyyy');
  if (val) {
    const parts = val.split('-');
    dd.value   = parts[2];
    mm.value   = parts[1];
    yyyy.value = parts[0];
  } else {
    dd.value = mm.value = yyyy.value = '';
  }
  displaySpan.style.display = 'none';
  editor.style.display      = 'inline-flex';
  setTimeout(function() { dd.focus(); dd.select(); }, 0);
}

function cancelarFechaInicio(editor) {
  editor.style.display = 'none';
  editor.previousElementSibling.style.display = '';
}

function fechaKey(input, e, seg) {
  const editor = input.closest('.inicio-editor');
  const dd   = editor.querySelector('.fecha-dd');
  const mm   = editor.querySelector('.fecha-mm');
  const yyyy = editor.querySelector('.fecha-yyyy');

  // Escape
  if (e.key === 'Escape') { e.preventDefault(); cancelarFechaInicio(editor); return; }
  // Enter
  if (e.key === 'Enter')  { e.preventDefault(); _commitFechaInicio(editor);  return; }
  // Tab — navegación natural entre inputs
  if (e.key === 'Tab') return;

  // Flecha izquierda — ir al campo anterior
  if (e.key === 'ArrowLeft') {
    e.preventDefault();
    if (seg === 'mm')   { dd.focus();   dd.select(); }
    if (seg === 'yyyy') { mm.focus();   mm.select(); }
    return;
  }
  // Flecha derecha — ir al siguiente campo
  if (e.key === 'ArrowRight') {
    e.preventDefault();
    if (seg === 'dd')   { mm.focus();   mm.select(); }
    if (seg === 'mm')   { yyyy.focus(); yyyy.select(); }
    return;
  }
  // Backspace — si vacío, retroceder campo
  if (e.key === 'Backspace') {
    if (input.value === '') {
      e.preventDefault();
      if (seg === 'mm')   { dd.focus();   dd.select(); }
      if (seg === 'yyyy') { mm.focus();   mm.select(); }
    }
    return;
  }

  // Bloquear todo excepto dígitos
  var isDigit = (e.key >= '0' && e.key <= '9');
  if (!isDigit) { e.preventDefault(); return; }

  // Auto-avance al completar el campo
  var currentLen = input.value.length;
  var maxLen = (seg === 'yyyy') ? 4 : 2;
  if (currentLen + 1 >= maxLen) {
    setTimeout(function() {
      if (seg === 'dd')   { mm.focus();   mm.select(); }
      else if (seg === 'mm')   { yyyy.focus(); yyyy.select(); }
      else if (seg === 'yyyy') { _commitFechaInicio(editor); }
    }, 0);
  }
}

async function _commitFechaInicio(editor) {
  const ddEl   = editor.querySelector('.fecha-dd');
  const mmEl   = editor.querySelector('.fecha-mm');
  const yyyyEl = editor.querySelector('.fecha-yyyy');
  const dd     = ddEl.value.padStart(2, '0');
  const mm     = mmEl.value.padStart(2, '0');
  const yyyy   = yyyyEl.value;
  const displaySpan = editor.previousElementSibling;
  const ofId   = displaySpan.dataset.ofId;

  const iso  = yyyy + '-' + mm + '-' + dd;
  const test = new Date(iso + 'T00:00:00');
  if (yyyy.length < 4 || isNaN(test.getTime())) {
    toast('Fecha inválida — completa DD / MM / YYYY', false);
    yyyyEl.focus();
    return;
  }

  const ok = await patchPlan(ofId, { fecha_inicio_plan: iso });
  if (ok) {
    displaySpan.dataset.value = iso;
    displaySpan.innerHTML     = dd + '/' + mm + '/' + yyyy;
    displaySpan.style.color   = '#4a9fff';
    const td = tasksData.find(function(t) { return t.id === ofId; });
    if (td) td.start = iso;
    setTimeout(function() { gantt.refresh(tasksData); }, 50);
    toast('✓ Inicio actualizado', true);
  } else {
    toast('Error al guardar', false);
  }
  editor.style.display      = 'none';
  displaySpan.style.display = '';
}

async function saveOrder() {
  const rows = [...tbody.querySelectorAll('tr')];
  rows.forEach((r, i) => r.querySelector('.row-num').textContent = i + 1);
  const idMap = {};
  tasksData.forEach(t => idMap[t.id] = t);
  gantt.refresh(rows.map(r => idMap[r.dataset.ofId]).filter(Boolean));
  const ok = (await Promise.all(
    rows.map((r, i) => patchPlan(r.dataset.ofId, { orden_plan: i + 1 }))
  )).every(Boolean);
  toast(ok ? '✓ Prioridad guardada' : 'Error al guardar orden', ok);
}
</script>
{% endif %}
{% endblock %}
