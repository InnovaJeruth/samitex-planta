    <startEvent id="StartEvent" name="Inicio - llega requerimiento"/>
    <endEvent id="EndEvent" name="Fin - piezas entregadas a Costura"/>
    <task id="T_1_1" name="1.1 Identificar oportunidad / pedido"/>
