# ─── Aplicación ──────────────────────────────────────────────
APP_NAME=Samitex Planta
APP_ENV=development               # development | production
DEBUG=True
SECRET_KEY=cambia-esta-clave-secreta-en-produccion

# ─── Base de Datos ────────────────────────────────────────────
# Opción A — producción (Render + Supabase): rellenar solo DATABASE_URL_OVERRIDE
DATABASE_URL_OVERRIDE=            # postgresql://user:pass@host:5432/db

# Opción B — desarrollo local (SQL Server): rellenar las variables de abajo
DB_SERVER=PANO0142\SQLEXPRESS
DB_NAME=SAMITEX-PLANTA
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_DRIVER=ODBC Driver 17 for SQL Server

# ─── Supabase Storage ─────────────────────────────────────────
SUPABASE_URL=                     # https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=             # service_role key (Settings → API)
SUPABASE_BUCKET=uploads           # nombre del bucket en Supabase Storage

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=cambia-este-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480            # 8 horas

# ─── Archivos ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ─── WebSocket ───────────────────────────────────────────────
WS_HEARTBEAT_SECONDS=30
