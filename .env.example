# ─── Aplicación ──────────────────────────────────────────────
APP_NAME=Samitex Planta
APP_ENV=development               # development | production
DEBUG=True
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
# Hosts permitidos (cabecera Host). CSV; "*" = todos (dev).
# En producción: los hosts reales, p.ej: erp.samitex.local,10.0.0.5
ALLOWED_HOSTS=*

# ─── Base de Datos SQL Server ─────────────────────────────────
DB_SERVER=PANO0142\SQLEXPRESS
DB_NAME=SAMITEX-PLANTA
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_DRIVER=ODBC Driver 17 for SQL Server

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=cambia-este-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480            # 8 horas

# ─── Archivos ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
